# ============================================================
# APP
# ============================================================
PROJECT_NAME="Banknote Recognition API"
ENV="development"
ENABLE_EXPERIMENT_API="True"
OPENAI_EXPERIMENT_MODEL="gpt-4o"
OPENAI_EXPERIMENT_FALLBACK_MODEL="gpt-4o"

GEMINI_EXPERIMENT_MODEL="gemini-2.5-flash"
GEMINI_EXPERIMENT_FALLBACK_MODEL="gemini-2.5-flash"
GEMINI_EXPERIMENT_PRO_MODEL=""

EXPERIMENT_IMAGE_DETAIL="high"
EXPERIMENT_TEMPERATURE=0
EXPERIMENT_MAX_OUTPUT_TOKENS=500

EXPERIMENT_AG0_ALLOW_ORIGINAL_FALLBACK="True"
EXPERIMENT_AG0_NO_HARD_STOP="True"
EXPERIMENT_AGENT_IMAGE_FALLBACK_ORIGINAL="True"

AG4_ACCEPT_TWO_STRONG_VOTES="True"

# ============================================================
# DATABASE
# ============================================================
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="banknote_system"

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY="your_strong_random_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================================
# FRONTEND / CORS (BACKEND)
# ============================================================
FRONTEND_URL="http://localhost:5173"
ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ============================================================
# GOOGLE API / GEMINI
# ============================================================
GOOGLE_API_KEY="your_google_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# ============================================================
# GOOGLE AUTH OAUTH2
# ============================================================
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# ============================================================
# IMAGE SEARCH / UPLOAD
# ============================================================
IMGBB_API_KEY="your_imgbb_api_key_here"
SERPAPI_KEY="your_serpapi_key_here"

# ============================================================
# CLOUDINARY
# ============================================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# ============================================================
# CHROME / SELENIUM
# ============================================================
CHROME_HEADLESS="True"
CHROME_BINARY_PATH="your_chrome_binary_path_here"
CHROMEDRIVER_PATH="your_chromedriver_path_here"
PAGE_LOAD_TIMEOUT=45

# ============================================================
# AGENT 1 ML/DL
# ============================================================
AGENT1_YOLO_MODEL_PATH="ml_models/yolo/best.pt"
AGENT1_RES_MODEL_PATH="ml_models/res/banknote_resnet50_stable_best.pth"
AGENT1_RES_CLASSES_PATH="ml_models/res/classes.txt"
AGENT1_YOLO_CONF=0.25
AGENT1_YOLO_IMGSZ=640
AGENT1_RES_IMGSZ=224

# ============================================================
# AGENT 2 LLM
# ============================================================
AG2_GEMINI_CHAIN_ENABLED=true
AG2_GEMINI_CHAIN_APPLY_PRODUCTION=true
AG2_GEMINI_CHAIN_APPLY_EXPERIMENT=true
AG2_GEMINI_CHAIN_MAX_MODELS=4
AG2_GEMINI_MODEL_CHAIN=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-2.5-flash-lite

# Backward compatible cho code cũ nếu vẫn đọc biến cũ
GEMINI_EXPERIMENT_MODEL=gemini-3.1-flash-lite
GEMINI_EXPERIMENT_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_EXPERIMENT_PRO_MODEL=

# ============================================================
# AGENT 3 CONFIG DEFAULTS
# ============================================================
AGENT3_PRIMARY_PROVIDER="serpapi"
AGENT3_PROVIDER="serpapi"
AGENT3_FALLBACK_ENABLED="True"
AGENT3_FALLBACK_PROVIDER="selenium"
AGENT3_SELENIUM_ENABLED="False"
AGENT3_V2_ENABLED="True"

# ============================================================
# DEPRECATED: SEPAY PAYMENT/WEBHOOK IS DISABLED
# These placeholders are retained only so old deployments can be cleaned up safely.
# ============================================================
SEPAY_API_KEY="your_sepay_api_key_here"
SEPAY_API_TOKEN="your_sepay_token_here"
SEPAY_ACCOUNT_NUMBER="your_sepay_account_number_here"
SEPAY_BANK_BRAND="your_sepay_bank_brand_here"

# ACTIVE VIETQR / MANUAL BANK TRANSFER
BANK_ACCOUNT_NUMBER="your_bank_account_number_here"
BANK_ID="your_bank_id_here"
ACCOUNT_NAME="your_account_name_here"
NAME_WEB="BANKNOTEAI"

# ============================================================
# VNPAY PAYMENT
# ============================================================
# VNPay is disabled by default for demo/local environments.
# The VNPAY_ENABLED=false flag prevents any VNPay transactions from being created.
#
# Enable ONLY after:
#   1. Your merchant website/domain is approved by VNPay.
#   2. The Return URL (VNPAY_RETURN_URL) is registered and approved by VNPay.
#   3. Real TMN code and hash secret have been issued by VNPay.
#
# Do NOT commit real credentials to version control.
# ============================================================
VNPAY_ENABLED="False"
VNPAY_TMN_CODE="your_sandbox_tmn_code"
VNPAY_HASH_SECRET="your_sandbox_hash_secret"
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:5173/vnpay-return"
VNPAY_IPN_URL="http://localhost:8000/api/v1/payment/vnpay/ipn"

# VNPay may require an approved public Return/IPN domain. Use an approved
# HTTPS domain or an ngrok URL for development when localhost is rejected.
# Do not commit real credentials.

# ============================================================
# EMAIL / SMTP
# ============================================================
EMAIL_NOTIFICATIONS_ENABLED="False"
SMTP_HOST="your_smtp_host_here"
SMTP_PORT=587
SMTP_USERNAME="your_smtp_username_here"
SMTP_PASSWORD="your_smtp_password_here"
SMTP_FROM_EMAIL="your_smtp_from_email_here"
SMTP_FROM_NAME="BanknoteAI"

# ============================================================
# CURRENCY PROVIDER
# ============================================================
CURRENCY_PROVIDER_NAME="your_currency_provider_name_here"
CURRENCY_PROVIDER_API_KEY="your_currency_provider_api_key_here"
CURRENCY_STALE_AFTER_HOURS=24
# =========================
# Groq - Agent 3 Formatter
# =========================
GROQ_API_KEY=

AGENT3_FORMATTER_PROVIDER="groq"
AGENT3_GROQ_FORMATTER_ENABLED="False"
AGENT3_GROQ_MODEL="auto"
AGENT3_GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
AGENT3_GROQ_FALLBACK_ENABLED=false

AGENT3_GROQ_TIMEOUT_SECONDS=8
AGENT3_GROQ_PRIMARY_MAX_RETRIES=1
AGENT3_GROQ_FALLBACK_MAX_RETRIES=1
AGENT3_GROQ_MAX_OUTPUT_TOKENS=500
AGENT3_GROQ_TEMPERATURE=0
AGENT3_FORMATTER_MAX_EVIDENCE=5

# AG2 Gemini Chain
AG2_GEMINI_CHAIN_ENABLED=true
AG2_GEMINI_CHAIN_APPLY_PRODUCTION=true
AG2_GEMINI_CHAIN_APPLY_EXPERIMENT=true
AG2_GEMINI_CHAIN_MAX_MODELS=4
AG2_GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# AG4 Conflict Rerun
AG4_CONFLICT_RERUN_ENABLED=true
AG4_CONFLICT_RERUN_APPLY_PRODUCTION=true
AG4_CONFLICT_RERUN_APPLY_EXPERIMENT=true
AG4_CONFLICT_RERUN_MAX_ATTEMPTS=2
AG4_CONFLICT_RERUN_USE_ORIGINAL_IMAGE=true
AG4_CONFLICT_RERUN_INCLUDE_AG1=true
AG4_CONFLICT_RERUN_INCLUDE_AG2=true
AG4_CONFLICT_RERUN_INCLUDE_AG3=true
AG4_CONFLICT_RERUN_ONLY_ON_PATTERN=1-1-1


# =========================================================
# GLOBAL VISION IMAGE RESIZE - PRODUCTION + EXPERIMENT
# =========================================================

VISION_RESIZE_ENABLED=false
VISION_RESIZE_MAX_SIDE=512
VISION_RESIZE_KEEP_ASPECT_RATIO=true
VISION_RESIZE_APPLY_PRODUCTION=true
VISION_RESIZE_APPLY_EXPERIMENT=true
VISION_RESIZE_APPLY_TO_AG1=true
VISION_RESIZE_APPLY_TO_AG2=true
VISION_RESIZE_APPLY_TO_AG3=true
VISION_RESIZE_SAVE_DEBUG=true
VISION_RESIZE_JPEG_QUALITY=85
